// .devcontainer/devcontainer.json
{
  "name": "SD Dev",
  "image": "nvcr.io/nvidia/pytorch:25.02-py3",
  "runArgs": [
    "--gpus", "all",
    "--shm-size=10g",
    "--ipc=host",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "workspaceFolder": "/workspace/SD",
  "mounts": [
    "source=/raid/jixingguan/opd/Self-Distillation,target=/workspace/SD,type=bind",
    "source=/raid/jixingguan/hf_cache,target=/root/.cache/huggingface,type=bind"
  ],  
  "remoteUser": "root",
  "remoteEnv": {
    "HF_ENDPOINT" : "https://hf-mirror.com",
    // "HTTP_PROXY" : "http://host.docker.internal:7890",
    // "HTTPS_PROXY" : "http://host.docker.internal:7890"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
